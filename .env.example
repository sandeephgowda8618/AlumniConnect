# AlumniConnect Production & Development Environment Template
# Copy this file to .env and configure values before starting services

ENVIRONMENT=development
PROJECT_NAME=AlumniConnect
VERSION=1.0.0

# 1. Authoritative MySQL Relational Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=alumniconnect
MYSQL_USER=alumni_app
MYSQL_PASSWORD=AlumniAppPass2026!
MYSQL_ROOT_PASSWORD=RootPassSecure2026!
# Connection URL (Defaults to high-fidelity SQLite for local offline development, or MySQL for Docker/production)
DATABASE_URL=sqlite:///./alumniconnect.db
# DATABASE_URL=mysql+pymysql://alumni_app:AlumniAppPass2026!@localhost:3306/alumniconnect?charset=utf8mb4

# 2. Supporting Redis Store & Distributed Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=ac:dev:v1:

# 3. Supporting Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=alumniconnect

# 4. Security & Authentication
SECRET_KEY=alumniconnect-secret-key-production-grade-random-string-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Recommendation Engine Weights (Recommendation Design §7)
WEIGHT_SKILL=0.30
WEIGHT_DOMAIN=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_CAREER=0.20
WEIGHT_QUALITY=0.15
TARGET_EXPERIENCE_YEARS=5.0
PLATFORM_AVERAGE_RATING=4.2
BAYESIAN_PRIOR_M=5.0
GATE_CAPACITY=true

# 6. Booking Business Rules (Business Rules BR-T16, BR-T17)
BOOKING_CANCELLATION_CUTOFF_HOURS=2
REOPEN_SLOT_ON_CANCELLATION=true
MAX_UPCOMING_BOOKINGS_PER_STUDENT=3

# 7. Frontend Integration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

